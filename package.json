{
  "name": "paper-cup",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Paper Cup Studio — Visual Novel Localization Agent Platform (Beta)",
  "scripts": {
    "setup": "node -e \"import('node:child_process').then(({execSync})=>{execSync('npm install',{cwd:'server',stdio:'inherit'});execSync('npm install',{cwd:'web',stdio:'inherit'});})\"",
    "build": "node -e \"import('node:child_process').then(({execSync})=>{execSync('npm run build',{cwd:'server',stdio:'inherit'});execSync('npm run build',{cwd:'web',stdio:'inherit'});})\"",
    "typecheck": "node -e \"import('node:child_process').then(({execSync})=>{execSync('npm run typecheck',{cwd:'server',stdio:'inherit'});execSync('npm run typecheck',{cwd:'web',stdio:'inherit'});})\"",
    "test": "node -e \"import('node:child_process').then(({execSync})=>{execSync('npx tsx tests/server.test.ts',{cwd:'server',stdio:'inherit'});})\"",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev"
  }
}
