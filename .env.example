# Paper Cup Studio 环境配置模板
# 复制为 .env 后按需填写，切勿将真实密钥提交到 Git 仓库。

# 服务监听与初始目录
PORT=3100
HOST=127.0.0.1
# PAPERCUP_WORKSPACE=
# PAPERCUP_PYTHON=python

# 支持的模型提供商 API Key（也可直接在 Web 界面中粘贴 Key 自动识别并配置）
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
MODELSCOPE_API_KEY=
ARK_API_KEY=
SILICONFLOW_API_KEY=
